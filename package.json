{
  "name": "family-pulse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite",
    "setup:db": "node scripts/setup-database.mjs",
    "auto-push": "node scripts/auto-push.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test server/server.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "jsbarcode": "^3.12.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.51.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
